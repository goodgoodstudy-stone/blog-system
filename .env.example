# Local demo only. Copy to .env when changing defaults.
PUBLIC_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
# Optional comma-separated exact browser origins; no paths or wildcards.
ADDITIONAL_ORIGINS=
MYSQL_ROOT_PASSWORD=local-root-only
MYSQL_PASSWORD=local-blog-only
DEMO_PASSWORD=Demo12345!
# Optional observability profile: set OTLP_ENDPOINT=alloy:4318 before starting it.
OTLP_ENDPOINT=
TRACE_SAMPLE_RATIO=1
# Logs complete text request/response bodies and MySQL SQL/args/results in both Compose profiles.
OBS_DEBUG_RAW=true
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=local-observability-only
