          "editorMode": "code",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"blog-api\",route!~\"/api/v1/health/.*\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "统计窗口内没有业务请求时显示“无请求”。"
